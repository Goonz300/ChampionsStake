# Dependencies
node_modules/

# Next.js
.next/
out/

# Environment
# Broad "ignore everything env-shaped, allowlist the safe template" instead
# of naming each file individually: the previous three lines (.env,
# .env.local, .env.*.local) never matched .env.production, .env.development,
# or .env.staging (no ".local" suffix) -- Vercel deployment prep surfaced
# this gap. Found during a deployment-readiness audit, before any such file
# existed on disk; fixed proactively rather than after an actual leak.
.env*
!.env.example

# Build artifacts
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Supabase local
supabase/.temp/

# Load testing: real seed files contain live session JWTs / test
# credentials for a staging project -- never committed. Only the
# .example.json template (no real values) is tracked.
load-tests/seed/*.json
!load-tests/seed/*.example.json
