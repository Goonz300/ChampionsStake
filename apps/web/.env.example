# ChampionsStake environment variables
# Copy to .env.local for development. Never commit .env.local.
#
# PROD-001 correction: this file previously listed Stripe variables from
# the original Architecture Document's anticipated provider — PAYMENT-001
# actually implemented Paystack instead (see PAYMENT-001-deliverable.md),
# and the Stripe entries were never removed. Fixed here.
#
# SCOPE NOTE: this file is for the Next.js app's own .env.local. Supabase
# Edge Function secrets (below the line marked "Edge Function secrets") are
# NOT read from this file at all — they must be set separately via
# `supabase secrets set KEY=value` or the Supabase Dashboard. Listed here
# only so every secret the platform needs is documented in one place.

# --- Supabase (Next.js side) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- KYC provider (Stripe Identity / Persona — chosen in Phase 5) ---
KYC_PROVIDER_KEY=

# --- Rate limiting ---
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# --- Observability ---
SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================================
# Edge Function secrets (set via `supabase secrets set`, NOT this file)
# ============================================================

# --- Paystack (PAYMENT-001's actual provider — supabase/functions/_payment/) ---
# PAYSTACK_SECRET_KEY=

# --- Scheduled job authentication (shared across every scheduler Edge
#     Function: wallet-reconciliation, challenge-expire, challenge-archive,
#     tournament-archive, notification-send, ai-trust-score, ai-fraud-scan,
#     payment-reconciliation) ---
# EDGE_SCHEDULED_JOB_SHARED_SECRET=

# --- Storage cleanup's own secret (STORE-001, kept separate from the
#     generic scheduled-job secret above by that phase's original design) ---
# STORAGE_CLEANUP_SHARED_SECRET=

